{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Zest Cookie Consent Configuration",
  "description": "Configuration schema for @freshjuice/zest cookie consent toolkit",
  "type": "object",
  "properties": {
    "lang": {
      "type": "string",
      "enum": ["auto", "en", "de", "es", "fr", "it", "pt", "nl", "pl", "uk", "ru", "ja", "zh"],
      "default": "auto",
      "description": "Language for UI labels. 'auto' detects from <html lang> or browser."
    },
    "position": {
      "type": "string",
      "enum": ["bottom", "bottom-left", "bottom-right", "top"],
      "default": "bottom",
      "description": "Position of the consent banner"
    },
    "theme": {
      "type": "string",
      "enum": ["light", "dark", "auto"],
      "default": "auto",
      "description": "Color theme for the UI. 'auto' follows system preference (prefers-color-scheme)"
    },
    "accentColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "default": "#0071e3",
      "description": "Accent color for buttons (hex format)"
    },
    "mode": {
      "type": "string",
      "enum": ["manual", "safe", "strict", "doomsday"],
      "default": "safe",
      "description": "Script blocking mode"
    },
    "autoInit": {
      "type": "boolean",
      "default": true,
      "description": "Automatically initialize on page load"
    },
    "respectDNT": {
      "type": "boolean",
      "default": true,
      "description": "Respect Do Not Track (DNT) and Global Privacy Control (GPC) browser signals"
    },
    "dntBehavior": {
      "type": "string",
      "enum": ["reject", "preselect", "ignore"],
      "default": "reject",
      "description": "Behavior when DNT/GPC is enabled: 'reject' auto-rejects non-essential without showing banner, 'preselect' shows banner with non-essential unchecked, 'ignore' ignores DNT signal"
    },
    "showWidget": {
      "type": "boolean",
      "default": true,
      "description": "Show floating widget after consent is given"
    },
    "branding": {
      "type": "boolean",
      "default": true,
      "description": "Show the 'Powered by Zest' attribution link on the banner and settings modal (links to https://cookiezest.com). Set to false to remove it."
    },
    "expiration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365,
      "default": 365,
      "description": "Consent cookie expiration in days"
    },
    "policyUrl": {
      "type": ["string", "null"],
      "format": "uri-reference",
      "default": null,
      "description": "URL to privacy policy page"
    },
    "imprintUrl": {
      "type": ["string", "null"],
      "format": "uri-reference",
      "default": null,
      "description": "URL to imprint/legal page"
    },
    "customStyles": {
      "type": "string",
      "default": "",
      "description": "Custom CSS to inject into Shadow DOM"
    },
    "blockedDomains": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "Domain to block (defaults to marketing category)"
          },
          {
            "type": "object",
            "properties": {
              "domain": {
                "type": "string",
                "description": "Domain to block"
              },
              "category": {
                "type": "string",
                "enum": ["functional", "analytics", "marketing"],
                "description": "Category for the blocked domain"
              }
            },
            "required": ["domain"]
          }
        ]
      },
      "default": [],
      "description": "Custom domains to block in addition to mode-based blocking"
    },
    "labels": {
      "type": "object",
      "description": "UI text labels for localization",
      "properties": {
        "banner": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "default": "We value your privacy"
            },
            "description": {
              "type": "string",
              "default": "We use cookies to enhance your browsing experience, serve personalized content, and analyze our traffic."
            },
            "acceptAll": {
              "type": "string",
              "default": "Accept All"
            },
            "rejectAll": {
              "type": "string",
              "default": "Reject All"
            },
            "settings": {
              "type": "string",
              "default": "Settings"
            }
          }
        },
        "modal": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "default": "Privacy Settings"
            },
            "description": {
              "type": "string",
              "default": "Manage your cookie preferences."
            },
            "save": {
              "type": "string",
              "default": "Save Preferences"
            },
            "acceptAll": {
              "type": "string",
              "default": "Accept All"
            },
            "rejectAll": {
              "type": "string",
              "default": "Reject All"
            }
          }
        },
        "widget": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "default": "Cookie Settings"
            }
          }
        }
      }
    },
    "categories": {
      "type": "object",
      "description": "Category definitions and labels",
      "properties": {
        "essential": {
          "$ref": "#/definitions/category"
        },
        "functional": {
          "$ref": "#/definitions/category"
        },
        "analytics": {
          "$ref": "#/definitions/category"
        },
        "marketing": {
          "$ref": "#/definitions/category"
        }
      }
    },
    "patterns": {
      "type": "object",
      "description": "Custom regex patterns for categorizing cookies/storage keys",
      "properties": {
        "essential": {
          "type": "array",
          "items": { "type": "string" }
        },
        "functional": {
          "type": "array",
          "items": { "type": "string" }
        },
        "analytics": {
          "type": "array",
          "items": { "type": "string" }
        },
        "marketing": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "intercept": {
      "type": "object",
      "description": "Granular toggles for Zest's interceptor layer. Default is true on every channel.",
      "properties": {
        "cookies": {
          "type": "boolean",
          "default": true,
          "description": "Intercept document.cookie writes"
        },
        "storage": {
          "type": "boolean",
          "default": true,
          "description": "Intercept localStorage / sessionStorage writes"
        },
        "scripts": {
          "type": "boolean",
          "default": true,
          "description": "Block third-party tracker <script> tags before they execute"
        },
        "network": {
          "type": "boolean",
          "default": true,
          "description": "Intercept fetch / XMLHttpRequest / navigator.sendBeacon calls. Catches trackers that ship via CMS first-party proxies (HubSpot, Cloudflare Zaraz, server-side GTM) where the <script> tag is same-origin but the runtime beacon is third-party."
        }
      }
    },
    "geo": {
      "description": "Opt-in geo / jurisdiction gating. Off by default (show the banner to everyone). `true` is shorthand for the hosted gateway; an object gives full control over the verdict source and decision.",
      "default": false,
      "oneOf": [
        {
          "type": "boolean",
          "description": "true = use the hosted zest-geo gateway (https://geo.cookiezest.com/privacy). Equivalent to { provider: 'gateway' }."
        },
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": ["gateway"],
              "description": "Use the hosted zest-geo gateway."
            },
            "endpoint": {
              "type": "string",
              "format": "uri",
              "description": "A self-hosted zest-geo /privacy URL (http/https only)."
            },
            "resolver": {
              "description": "Function returning the verdict yourself (sync or async): { isEU, isEEA, isGDPR, isCCPA, isUSPrivacy, regulations[] }. Takes precedence over provider/endpoint. JS-only — not settable via data attributes or serialised plugin config."
            },
            "decide": {
              "description": "Function mapping a verdict to an action ('consent' | 'notice' | 'allow' | 'block'). Defaults to: GDPR -> consent, US-privacy -> notice, otherwise allow. JS-only."
            },
            "timeout": {
              "type": "integer",
              "minimum": 100,
              "maximum": 10000,
              "default": 1500,
              "description": "Milliseconds before resolution gives up."
            },
            "fallback": {
              "type": "string",
              "enum": ["consent", "notice", "allow", "block"],
              "default": "consent",
              "description": "Action applied if resolution fails or times out (fail-closed)."
            }
          }
        }
      ]
    },
    "callbacks": {
      "type": "object",
      "description": "Callback functions for consent events",
      "properties": {
        "onAccept": {
          "description": "Called when user accepts cookies"
        },
        "onReject": {
          "description": "Called when user rejects all non-essential cookies"
        },
        "onChange": {
          "description": "Called when consent state changes"
        },
        "onReady": {
          "description": "Called when Zest is initialized"
        },
        "onGeo": {
          "description": "Called once geo resolution completes: (action, verdict). action is 'consent' | 'notice' | 'allow' | 'block'; verdict is the sanitized jurisdiction object, or null on failure. Only fires when `geo` is configured."
        }
      }
    }
  },
  "definitions": {
    "category": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean",
          "default": false,
          "description": "Hide this category from the settings modal. Essential cannot be hidden. Hidden categories are forced to false (rejected) in the consent state — there is no way for a visitor to accept a category they cannot see."
        }
      }
    }
  }
}
